<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated with glade 3.38.2 -->
<interface domain="svx">
  <requires lib="gtk+" version="3.24"/>
  <!--
    Writer 2027 Type System picker (spec V3 10-16, 52-54).

    WeldToolbarPopup requires the popover's direct child container to carry the
    stable id "container" (svtools toolbarmenu.cxx: weld_container("container")).

    Design decisions:
    - "Custom typography" is CURRENT state, not a fake preset row.
    - Left column = CURRENT + PRESETS. The preset list is a custom
      Writer2027TypeSystemPresetList drawing surface (id "preset_list") with
      explicit rows, hover/selection, mouse hit-testing and a Current marker
      (spec 12/13/14); not a backend TreeView.
    - Right column = one rich font-rendered preview surface
      (id "preview_surface", Writer2027TypeSystemPreview) that draws each sample
      in its resolved role font (spec 10/52).
    - Apply button applies the selected system and closes; click/Enter previews
      only (spec 14/19).
    - Target logical width 860 (spec 15), clamped by the framework.
  -->
  <object class="GtkPopover" id="Writer2027TypeSystemPopup">
    <property name="can-focus">False</property>
    <property name="position">bottom</property>
    <property name="border-width">12</property>
    <property name="constrain-to">none</property>
    <child>
      <object class="GtkBox" id="container">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">1</property>
            <child>
              <object class="GtkLabel" id="typesystem_title">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes" context="writer2027typesystempopup|typesystem_title">Type System</property>
                <attributes>
                  <attribute name="weight" value="bold"/>
                  <attribute name="scale" value="1.3"/>
                </attributes>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="typesystem_subtitle">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="wrap">True</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes" context="writer2027typesystempopup|typesystem_subtitle">Coordinated typography for this document</property>
                <attributes>
                  <attribute name="scale" value="0.95"/>
                </attributes>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">14</property>
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
                <property name="spacing">3</property>
                <property name="width-request">250</property>
                <child>
                  <object class="GtkLabel" id="typesystem_current_header">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes" context="writer2027typesystempopup|typesystem_current_header">CURRENT</property>
                    <attributes>
                      <attribute name="weight" value="bold"/>
                      <attribute name="scale" value="0.8"/>
                    </attributes>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="typesystem_current">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes" context="writer2027typesystempopup|typesystem_current">Custom typography</property>
                    <attributes>
                      <attribute name="weight" value="bold"/>
                    </attributes>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="typesystem_presets_header">
                    <property name="visible">True</property>
