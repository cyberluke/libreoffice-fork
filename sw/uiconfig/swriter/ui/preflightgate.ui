<?xml version="1.0" encoding="UTF-8"?>
<!-- Writer 2027 Publish preflight gate (Phase 10). -->
<interface domain="sw">
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkMessageDialog" id="Writer2027PreflightGate">
    <property name="can-focus">False</property>
    <property name="modal">True</property>
    <property name="resizable">False</property>
    <property name="type-hint">dialog</property>
    <property name="message-type">warning</property>
    <property name="buttons">none</property>
    <property name="title" translatable="yes" context="preflightgate|title">Publication Preflight</property>
    <child internal-child="vbox">
      <object class="GtkBox">
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child internal-child="action_area">
          <object class="GtkButtonBox">
            <property name="can-focus">False</property>
            <property name="layout-style">end</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="preflightGateMessage">
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="xalign">0</property>
            <property name="wrap">True</property>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>