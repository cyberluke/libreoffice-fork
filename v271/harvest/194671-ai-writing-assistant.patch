index 000000000000..ac92aef1bd1a
--- /dev/null
+++ b/sw/source/uibase/misc/airewritedialog.cxx
@@ -0,0 +1,283 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include <sal/config.h>
+
+#include <config_features.h>
+#include <config_wasm_strip.h>
+
+#if HAVE_FEATURE_CURL && !ENABLE_WASM_STRIP_EXTRA
+
+#include <airewritedialog.hxx>
+#include <aihelper.hxx>
+#include <wrtsh.hxx>
+#include <view.hxx>
+#include <docsh.hxx>
+#include <doc.hxx>
+#include <IDocumentRedlineAccess.hxx>
+#include <redline.hxx>
+#include <sal/log.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/weld.hxx>
+#include <strings.hrc>
+#include <swtypes.hxx>
+#include <fstream>
+#include <ctime>
+
+// Debug logging helper
+static void DialogDebugLog(const char* msg)
+{
+    std::ofstream logFile("/tmp/ai_debug.log", std::ios::app);
+    if (logFile.is_open())
+    {
+        std::time_t now = std::time(nullptr);
+        char timeStr[64];
+        std::strftime(timeStr, sizeof(timeStr), "%Y-%m-%d %H:%M:%S", std::localtime(&now));
+        logFile << "[" << timeStr << "] [Dialog] " << msg << std::endl;
+        logFile.close();
+    }
+}
+
+static void DialogDebugLog(const std::string& msg)
+{
+    DialogDebugLog(msg.c_str());
+}
+
+SwAIRewriteDialog::SwAIRewriteDialog(weld::Window* pParent, SwWrtShell& rSh)
+    : GenericDialogController(pParent, u"modules/swriter/ui/airewritedialog.ui"_ustr,
+                              u"AIRewriteDialog"_ustr)
+    , m_rWrtSh(rSh)
+    , m_bGenerating(false)
+    , m_bHasGenerated(false)
+    , m_xStyleBox(m_xBuilder->weld_combo_box(u"stylebox"_ustr))
+    , m_xOriginalText(m_xBuilder->weld_text_view(u"originaltext"_ustr))
+    , m_xSuggestionText(m_xBuilder->weld_text_view(u"suggestiontext"_ustr))
+    , m_xGenerateBtn(m_xBuilder->weld_button(u"generate"_ustr))
+    , m_xApplyTrackedBtn(m_xBuilder->weld_button(u"applytracked"_ustr))
+    , m_xReplaceBtn(m_xBuilder->weld_button(u"replace"_ustr))
+    , m_xCancelBtn(m_xBuilder->weld_button(u"cancel"_ustr))
+{
+    // Set fixed dialog size - width 660px, height 500px
+    // Wide enough to fit all buttons comfortably
+    m_xDialog->set_size_request(660, 500);
+
+    // Get selected text
+    m_sOriginalText = m_rWrtSh.GetSelText();
+    m_xOriginalText->set_text(m_sOriginalText);
+
+    // Set default style
+    m_xStyleBox->set_active(0);
+
+    // Connect button handlers
+    m_xGenerateBtn->connect_clicked(LINK(this, SwAIRewriteDialog, GenerateHdl));
+    m_xApplyTrackedBtn->connect_clicked(LINK(this, SwAIRewriteDialog, ApplyTrackedHdl));
+    m_xReplaceBtn->connect_clicked(LINK(this, SwAIRewriteDialog, ReplaceHdl));
+    m_xCancelBtn->connect_clicked(LINK(this, SwAIRewriteDialog, CancelHdl));
+
+    UpdateButtonStates();
+}
+
+void SwAIRewriteDialog::UpdateButtonStates()
+{
+    bool bHasSuggestion = !m_sSuggestion.isEmpty();
+
+    // Initially: only Generate button visible
+    // After generation: show Regenerate, Apply, Replace, Cancel
+    if (!m_bHasGenerated)
+    {
+        // Initial state: only Generate visible (highlighted as default)
+        m_xGenerateBtn->set_visible(true);
+        m_xGenerateBtn->set_sensitive(!m_bGenerating);
+        m_xApplyTrackedBtn->set_visible(false);
+        m_xReplaceBtn->set_visible(false);
+        m_xCancelBtn->set_visible(false);
+    }
+    else
+    {
+        // After generation: show all buttons
+        // Change Generate label to Regenerate
+        m_xGenerateBtn->set_label(SwResId(STR_AI_REGENERATE));
+        m_xGenerateBtn->set_visible(true);
+        m_xGenerateBtn->set_sensitive(!m_bGenerating);
+        m_xApplyTrackedBtn->set_visible(true);
+        m_xApplyTrackedBtn->set_sensitive(bHasSuggestion);
+        m_xReplaceBtn->set_visible(true);
+        m_xReplaceBtn->set_sensitive(bHasSuggestion);
+        m_xCancelBtn->set_visible(true);
+    }
+}
+
+IMPL_LINK_NOARG(SwAIRewriteDialog, GenerateHdl, weld::Button&, void)
+{
+    DialogDebugLog("=== GenerateHdl called ===");
+
+    if (m_bGenerating)
+    {
+        DialogDebugLog("Already generating, returning early");
+        return;
+    }
+
+    m_bGenerating = true;
+    UpdateButtonStates();
+
+    // Get selected style
+    OUString sStyle = m_xStyleBox->get_active_text();
+    DialogDebugLog(std::string("Selected style: ") + OUStringToOString(sStyle, RTL_TEXTENCODING_UTF8).getStr());
+
+    // Get AI config
+    SwAIHelper::AIConfig aConfig = SwAIHelper::GetAIConfig();
+
+    if (aConfig.m_sApiUrl.isEmpty() || aConfig.m_sAuthKey.isEmpty())
+    {
+        SAL_WARN("sw.ui", "SwAIRewriteDialog: AI not configured");
+        std::unique_ptr<weld::MessageDialog> xBox(
+            Application::CreateMessageDialog(m_xDialog.get(),
+                VclMessageType::Warning, VclButtonsType::Ok,
+                SwResId(STR_AI_NOT_CONFIGURED)));
+        xBox->run();
+        m_bGenerating = false;
+        UpdateButtonStates();
+        return;
+    }
+
+    // Build the prompt
+    OUString sSystemPrompt = SwAIHelper::BuildRewriteSystemPrompt(sStyle);
+    DialogDebugLog("Calling AI API...");
+
+    // Call the AI API
+    m_sSuggestion = SwAIHelper::CallChatCompletion(aConfig, sSystemPrompt, m_sOriginalText);
+
+    DialogDebugLog(std::string("API returned, suggestion length: ") + std::to_string(m_sSuggestion.getLength()));
+
+    if (m_sSuggestion.isEmpty())
+    {
+        DialogDebugLog("ERROR: Suggestion is empty!");
+        SAL_WARN("sw.ui", "SwAIRewriteDialog: AI returned empty response");
+        std::unique_ptr<weld::MessageDialog> xBox(
+            Application::CreateMessageDialog(m_xDialog.get(),
+                VclMessageType::Warning, VclButtonsType::Ok,
+                SwResId(STR_AI_GENERATION_FAILED)));
+        xBox->run();
+    }
+    else
+    {
+        DialogDebugLog(std::string("Setting suggestion text, first 100 chars: ") +
+                       OUStringToOString(m_sSuggestion.copy(0, std::min<sal_Int32>(100, m_sSuggestion.getLength())),
+                                         RTL_TEXTENCODING_UTF8).getStr());
+        SAL_WARN("sw.ui", "SwAIRewriteDialog: Setting suggestion text, length=" << m_sSuggestion.getLength());
+
+        // Set the new text
+        m_xSuggestionText->set_text(m_sSuggestion);
+        DialogDebugLog("set_text called");
+
+        // Select all text to make it visible (workaround for rendering issue)
+        m_xSuggestionText->select_region(0, -1);
+        DialogDebugLog("select_region(0, -1) called");
+
+        // Grab focus to force the widget to redraw
+        m_xSuggestionText->grab_focus();
+        DialogDebugLog("grab_focus called");
+
+        // Force UI to process pending events and redraw after CURL blocked the main thread
+        Application::Yield();
+        DialogDebugLog("Application::Yield() called");
+
+        // Verify what was actually set
+        OUString sVerify = m_xSuggestionText->get_text();
+        DialogDebugLog(std::string("VERIFY: get_text() returned length=") + std::to_string(sVerify.getLength()));
+
+        SAL_WARN("sw.ui", "SwAIRewriteDialog: Suggestion text set successfully");
+
+        // Mark that we've generated at least once
+        m_bHasGenerated = true;
+    }
+
+    m_bGenerating = false;
+    UpdateButtonStates();
+    DialogDebugLog("GenerateHdl completed");
+}
+
+void SwAIRewriteDialog::ApplyAsTrackedChanges()
+{
+    // Get the current suggestion (might have been edited by user)
+    OUString sSuggestion = m_xSuggestionText->get_text();
+
+    if (sSuggestion.isEmpty())
+        return;
+
+    // Get the document's redline access
+    IDocumentRedlineAccess& rRedlineAccess = m_rWrtSh.GetDoc()->getIDocumentRedlineAccess();
+
+    // Save current redline state
+    RedlineFlags eOldFlags = rRedlineAccess.GetRedlineFlags();
+
+    // Enable recording of changes
+    rRedlineAccess.SetRedlineFlags(RedlineFlags::On | RedlineFlags::ShowInsert | RedlineFlags::ShowDelete);
+
+    // Start an undo group
+    m_rWrtSh.StartAllAction();
+    m_rWrtSh.StartUndo(SwUndoId::REPLACE);
+
+    // Delete the selected text (will create a delete redline)
+    m_rWrtSh.Delete(false);
+
+    // Insert the new text (will create an insert redline)
+    m_rWrtSh.Insert(sSuggestion);
+
+    // End undo group
+    m_rWrtSh.EndUndo();
+    m_rWrtSh.EndAllAction();
+
+    // Restore previous redline state (but keep showing changes)
+    rRedlineAccess.SetRedlineFlags(eOldFlags | RedlineFlags::ShowInsert | RedlineFlags::ShowDelete);
+}
+
+void SwAIRewriteDialog::ReplaceDirectly()
+{
+    // Get the current suggestion (might have been edited by user)
+    OUString sSuggestion = m_xSuggestionText->get_text();
+
+    if (sSuggestion.isEmpty())
+        return;
+
+    // Start an undo group
+    m_rWrtSh.StartAllAction();
+    m_rWrtSh.StartUndo(SwUndoId::REPLACE);
+
+    // Delete the selected text
+    m_rWrtSh.Delete(false);
+
+    // Insert the new text
+    m_rWrtSh.Insert(sSuggestion);
+
+    // End undo group
+    m_rWrtSh.EndUndo();
+    m_rWrtSh.EndAllAction();
+}
+
+IMPL_LINK_NOARG(SwAIRewriteDialog, ApplyTrackedHdl, weld::Button&, void)
+{
+    ApplyAsTrackedChanges();
+    m_xDialog->response(RET_OK);
+}
+
+IMPL_LINK_NOARG(SwAIRewriteDialog, ReplaceHdl, weld::Button&, void)
+{
+    ReplaceDirectly();
+    m_xDialog->response(RET_OK);
+}
+
+IMPL_LINK_NOARG(SwAIRewriteDialog, CancelHdl, weld::Button&, void)
+{
+    m_xDialog->response(RET_CANCEL);
+}
+
