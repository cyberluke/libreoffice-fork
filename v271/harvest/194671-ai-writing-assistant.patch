+/// Dialog for AI-powered text rewriting
+class SwAIRewriteDialog final : public weld::GenericDialogController
+{
+public:
+    SwAIRewriteDialog(weld::Window* pParent, SwWrtShell& rSh);
+
+private:
+    SwWrtShell& m_rWrtSh;
+    OUString m_sOriginalText;
+    OUString m_sSuggestion;
+    bool m_bGenerating;
+    bool m_bHasGenerated;
+
+    std::unique_ptr<weld::ComboBox> m_xStyleBox;
+    std::unique_ptr<weld::TextView> m_xOriginalText;
+    std::unique_ptr<weld::TextView> m_xSuggestionText;
+    std::unique_ptr<weld::Button> m_xGenerateBtn;
+    std::unique_ptr<weld::Button> m_xApplyTrackedBtn;
+    std::unique_ptr<weld::Button> m_xReplaceBtn;
+    std::unique_ptr<weld::Button> m_xCancelBtn;
+
+    DECL_LINK(GenerateHdl, weld::Button&, void);
+    DECL_LINK(ApplyTrackedHdl, weld::Button&, void);
+    DECL_LINK(ReplaceHdl, weld::Button&, void);
+    DECL_LINK(CancelHdl, weld::Button&, void);
+
+    /// Apply the AI suggestion as tracked changes (redlines)
+    void ApplyAsTrackedChanges();
+
+    /// Replace the selection directly without tracking
+    void ReplaceDirectly();
+
+    /// Update button states based on whether we have a suggestion
+    void UpdateButtonStates();
+};
