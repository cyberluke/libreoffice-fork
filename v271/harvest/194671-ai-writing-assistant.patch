+OUString BuildRewriteSystemPrompt(const OUString& rStyle)
+{
+    OUString sPrompt = u"You are a writing assistant. Your task is to rewrite the given text "_ustr;
+
+    if (rStyle == "Improve clarity")
+    {
+        sPrompt += u"to make it clearer and easier to understand. "_ustr;
+    }
+    else if (rStyle == "More formal")
+    {
+        sPrompt += u"in a more formal, professional tone. "_ustr;
+    }
+    else if (rStyle == "More concise")
+    {
+        sPrompt += u"to be more concise and shorter while preserving the meaning. "_ustr;
+    }
+    else if (rStyle == "Simpler language")
+    {
+        sPrompt += u"using simpler words and shorter sentences for easier reading. "_ustr;
+    }
+    else if (rStyle == "Fix grammar")
+    {
+        sPrompt += u"by fixing any grammar, spelling, and punctuation errors. "_ustr;
+    }
+    else
+    {
+        sPrompt += u"to improve it. "_ustr;
+    }
+
+    sPrompt += u"Return ONLY the rewritten text without any explanations, comments, or additional text. "_ustr;
+    sPrompt += u"Preserve the original language of the text."_ustr;
+
+    return sPrompt;
+}
