+    DebugLog(std::string("GetAIConfig: ModelName has value: ") + (oModelName.has_value() ? "yes" : "no"));
+
+    SAL_INFO("sw.ai", "GetAIConfig: ApiURL has value: " << (oApiUrl.has_value() ? "yes" : "no"));
+    SAL_INFO("sw.ai", "GetAIConfig: AuthKey has value: " << (oAuthKey.has_value() ? "yes" : "no"));
+    SAL_INFO("sw.ai", "GetAIConfig: ModelName has value: " << (oModelName.has_value() ? "yes" : "no"));
+
+    if (oApiUrl)
+    {
+        aConfig.m_sApiUrl = *oApiUrl;
+        DebugLog(std::string("GetAIConfig: ApiURL = ") + OUStringToOString(aConfig.m_sApiUrl, RTL_TEXTENCODING_UTF8).getStr());
+        SAL_INFO("sw.ai", "GetAIConfig: ApiURL = " << aConfig.m_sApiUrl);
+    }
+    if (oAuthKey)
+    {
+        aConfig.m_sAuthKey = *oAuthKey;
+        DebugLog(std::string("GetAIConfig: AuthKey length = ") + std::to_string(aConfig.m_sAuthKey.getLength()));
+        SAL_INFO("sw.ai", "GetAIConfig: AuthKey length = " << aConfig.m_sAuthKey.getLength());
+    }
+    if (oModelName)
+    {
+        aConfig.m_sModelName = *oModelName;
+        DebugLog(std::string("GetAIConfig: ModelName = ") + OUStringToOString(aConfig.m_sModelName, RTL_TEXTENCODING_UTF8).getStr());
+        SAL_INFO("sw.ai", "GetAIConfig: ModelName = " << aConfig.m_sModelName);
+    }
+
+    DebugLog("GetAIConfig() returning");
+    return aConfig;
+}
+
+bool IsAIConfigured()
+{
+    bool bEnabled = officecfg::Office::Linguistic::AIWritingAssistant::Enabled::get();
+    SAL_INFO("sw.ai", "IsAIConfigured: Enabled = " << (bEnabled ? "true" : "false"));
+
+    if (!bEnabled)
+    {
+        SAL_WARN("sw.ai", "IsAIConfigured: AI is DISABLED in configuration");
+        return false;
+    }
+
+    AIConfig aConfig = GetAIConfig();
+    bool bApiUrlOk = !aConfig.m_sApiUrl.isEmpty();
+    bool bAuthKeyOk = !aConfig.m_sAuthKey.isEmpty();
+
+    SAL_INFO("sw.ai", "IsAIConfigured: ApiURL empty=" << (bApiUrlOk ? "no" : "yes")
+             << ", AuthKey empty=" << (bAuthKeyOk ? "no" : "yes"));
+
+    if (!bApiUrlOk || !bAuthKeyOk)
+    {
+        SAL_WARN("sw.ai", "IsAIConfigured: Missing config - ApiURL ok=" << bApiUrlOk
+                 << ", AuthKey ok=" << bAuthKeyOk);
+    }
+
+    return bApiUrlOk && bAuthKeyOk;
+}
