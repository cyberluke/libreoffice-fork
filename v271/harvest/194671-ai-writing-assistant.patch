+OUString CallChatCompletion(const AIConfig& rConfig,
+                             const OUString& rSystemPrompt,
+                             const OUString& rUserPrompt)
+{
+    DebugLog("=== CallChatCompletion() called ===");
+
+    // Debug logging of config values
+    DebugLog(std::string("CallChatCompletion: ApiURL = '") + OUStringToOString(rConfig.m_sApiUrl, RTL_TEXTENCODING_UTF8).getStr() + "'");
+    DebugLog(std::string("CallChatCompletion: AuthKey length = ") + std::to_string(rConfig.m_sAuthKey.getLength()));
+    DebugLog(std::string("CallChatCompletion: ModelName = '") + OUStringToOString(rConfig.m_sModelName, RTL_TEXTENCODING_UTF8).getStr() + "'");
+    DebugLog(std::string("CallChatCompletion: UserPrompt length = ") + std::to_string(rUserPrompt.getLength()));
+
+    SAL_WARN("sw.ui", "CallChatCompletion: ApiURL = '" << rConfig.m_sApiUrl << "'");
+    SAL_WARN("sw.ui", "CallChatCompletion: AuthKey length = " << rConfig.m_sAuthKey.getLength());
+    SAL_WARN("sw.ui", "CallChatCompletion: ModelName = '" << rConfig.m_sModelName << "'");
+    SAL_WARN("sw.ui", "CallChatCompletion: UserPrompt length = " << rUserPrompt.getLength());
+
+    constexpr tools::Long CURL_TIMEOUT = 60L; // Longer timeout for AI responses
+
+    DebugLog("Initializing CURL...");
+    std::unique_ptr<CURL, std::function<void(CURL*)>> curl(curl_easy_init(),
+                                                           [](CURL* p) { curl_easy_cleanup(p); });
+    if (!curl)
+    {
+        DebugLog("ERROR: Failed to initialize CURL");
+        SAL_WARN("sw.ui", "AIHelper: Failed to initialize CURL");
+        return {};
+    }
+    DebugLog("CURL initialized successfully");
+
+    ::InitCurl_easy(curl.get());
+
+    OString aApiUrl = OUStringToOString(rConfig.m_sApiUrl, RTL_TEXTENCODING_UTF8);
+    SAL_WARN("sw.ui", "CallChatCompletion: Setting URL to: " << aApiUrl);
+    (void)curl_easy_setopt(curl.get(), CURLOPT_URL, aApiUrl.getStr());
+    // Don't use FAILONERROR - we want to see the response body even on errors
+    (void)curl_easy_setopt(curl.get(), CURLOPT_TIMEOUT, CURL_TIMEOUT);
+
+    // Set up response handling
+    std::string response_body;
+    (void)curl_easy_setopt(curl.get(), CURLOPT_WRITEFUNCTION,
+                           +[](void* buffer, size_t size, size_t nmemb, void* userp) -> size_t {
+                               if (!userp)
+                                   return 0;
+                               std::string* response = static_cast<std::string*>(userp);
+                               size_t real_size = size * nmemb;
+                               response->append(static_cast<char*>(buffer), real_size);
+                               return real_size;
+                           });
+    (void)curl_easy_setopt(curl.get(), CURLOPT_WRITEDATA, static_cast<void*>(&response_body));
+
+    // Set up headers
+    struct curl_slist* headers = nullptr;
+    headers = curl_slist_append(headers, "Content-Type: application/json");
+
+    OString aAuthHeader = "Authorization: Bearer " + OUStringToOString(rConfig.m_sAuthKey, RTL_TEXTENCODING_UTF8);
+    headers = curl_slist_append(headers, aAuthHeader.getStr());
+
+    (void)curl_easy_setopt(curl.get(), CURLOPT_HTTPHEADER, headers);
+
+    // Build JSON request body using boost::property_tree
+    boost::property_tree::ptree requestBody;
+    requestBody.put("model", OUStringToOString(rConfig.m_sModelName, RTL_TEXTENCODING_UTF8).getStr());
+
+    boost::property_tree::ptree messages;
+
+    // System message
+    boost::property_tree::ptree systemMsg;
+    systemMsg.put("role", "system");
+    systemMsg.put("content", OUStringToOString(rSystemPrompt, RTL_TEXTENCODING_UTF8).getStr());
+    messages.push_back(std::make_pair("", systemMsg));
+
+    // User message
+    boost::property_tree::ptree userMsg;
+    userMsg.put("role", "user");
+    userMsg.put("content", OUStringToOString(rUserPrompt, RTL_TEXTENCODING_UTF8).getStr());
+    messages.push_back(std::make_pair("", userMsg));
+
+    requestBody.add_child("messages", messages);
+    requestBody.put("temperature", 0.7);
+
+    std::stringstream ss;
+    boost::property_tree::write_json(ss, requestBody);
+    std::string jsonBody = ss.str();
+
+    // Fix: boost::property_tree writes numbers as strings in JSON
+    // OpenAI API requires temperature to be a number, not a string
+    // Replace "temperature": "0.7" with "temperature": 0.7
+    size_t tempPos = jsonBody.find("\"temperature\": \"");
+    if (tempPos != std::string::npos)
+    {
+        size_t valueStart = tempPos + 16; // length of "\"temperature\": \""
+        size_t valueEnd = jsonBody.find("\"", valueStart);
+        if (valueEnd != std::string::npos)
+        {
+            std::string tempValue = jsonBody.substr(valueStart, valueEnd - valueStart);
+            jsonBody = jsonBody.substr(0, tempPos) + "\"temperature\": " + tempValue +
+                       jsonBody.substr(valueEnd + 1);
+        }
+    }
+
+    DebugLog(std::string("JSON body after temperature fix (first 300 chars): ") + jsonBody.substr(0, std::min<size_t>(300, jsonBody.length())));
+    SAL_WARN("sw.ui", "CallChatCompletion: JSON request body length: " << jsonBody.length());
+    // Log first 500 chars of request for debugging (don't log full body as it may contain sensitive text)
+    SAL_WARN("sw.ui", "CallChatCompletion: JSON request (first 500 chars): "
+             << jsonBody.substr(0, std::min<size_t>(500, jsonBody.length())));
+
+    (void)curl_easy_setopt(curl.get(), CURLOPT_POSTFIELDS, jsonBody.c_str());
+
+    // Perform the request
+    DebugLog("Performing CURL request...");
+    CURLcode cc = curl_easy_perform(curl.get());
+    DebugLog(std::string("CURL perform returned code: ") + std::to_string(static_cast<int>(cc)));
+
+    // Clean up headers
+    curl_slist_free_all(headers);
+
+    if (cc != CURLE_OK)
+    {
+        const char* pError = curl_easy_strerror(cc);
+        DebugLog(std::string("ERROR: CURL failed with code ") + std::to_string(static_cast<int>(cc)) + ": " + (pError ? pError : "unknown"));
+        DebugLog(std::string("Response body (if any): ") + response_body);
+        SAL_WARN("sw.ui", "AIHelper: CURL perform returned with error code " << static_cast<sal_Int32>(cc)
+                 << ": " << (pError ? pError : "unknown"));
+        SAL_WARN("sw.ui", "AIHelper: Response body (if any): " << response_body.c_str());
+        return {};
+    }
+
+    tools::Long nStatusCode = 0;
+    curl_easy_getinfo(curl.get(), CURLINFO_RESPONSE_CODE, &nStatusCode);
+    DebugLog(std::string("HTTP response code: ") + std::to_string(nStatusCode));
+    DebugLog(std::string("Response body length: ") + std::to_string(response_body.length()));
+    SAL_WARN("sw.ui", "AIHelper: HTTP response code: " << nStatusCode);
+    SAL_WARN("sw.ui", "AIHelper: Response body length: " << response_body.length());
+
+    if (nStatusCode != 200)
+    {
+        DebugLog(std::string("ERROR: Non-200 status code: ") + std::to_string(nStatusCode));
+        DebugLog(std::string("Response body: ") + response_body);
+        SAL_WARN("sw.ui", "AIHelper: CURL request returned with status code: " << nStatusCode);
+        SAL_WARN("sw.ui", "AIHelper: Response body: " << response_body.c_str());
+        return {};
+    }
+
+    DebugLog("Parsing JSON response...");
+    // Parse the response
+    try
+    {
+        boost::property_tree::ptree root;
+        std::stringstream aStream(response_body);
+        boost::property_tree::read_json(aStream, root);
+
+        // Navigate to choices[0].message.content
+        boost::property_tree::ptree& choices = root.get_child("choices");
+        if (choices.empty())
+        {
+            DebugLog("ERROR: API did not return any choices");
+            SAL_WARN("sw.ui", "AIHelper: API did not return any choices");
+            return {};
+        }
+
+        const boost::property_tree::ptree& firstChoice = choices.begin()->second;
+        const boost::property_tree::ptree& message = firstChoice.get_child("message");
+        const std::string content = message.get<std::string>("content");
+
+        DebugLog(std::string("SUCCESS: Got response content, length=") + std::to_string(content.length()));
+        return OUString::fromUtf8(content);
+    }
+    catch (const boost::property_tree::ptree_error& e)
+    {
+        DebugLog(std::string("ERROR: Failed to parse JSON: ") + e.what());
+        SAL_WARN("sw.ui", "AIHelper: Failed to parse JSON response: " << e.what());
+        return {};
+    }
+}
