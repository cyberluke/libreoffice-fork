+
+#include "optaiwritingassistant.hxx"
+#include <officecfg/Office/Linguistic.hxx>
+#include <comphelper/configuration.hxx>
+
+OptAIWritingAssistantTabPage::OptAIWritingAssistantTabPage(weld::Container* pPage,
+                                                           weld::DialogController* pController,
+                                                           const SfxItemSet& rSet)
+    : SfxTabPage(pPage, pController, u"cui/ui/optaiwritingassistantpage.ui"_ustr,
+                 u"OptAIWritingAssistantPage"_ustr, &rSet)
+    , m_xEnabled(m_xBuilder->weld_check_button(u"enabled"_ustr))
+    , m_xAPIUrl(m_xBuilder->weld_entry(u"apiurl"_ustr))
+    , m_xAuthKey(m_xBuilder->weld_entry(u"authkey"_ustr))
+    , m_xModelName(m_xBuilder->weld_entry(u"modelname"_ustr))
+{
+}
+
+OptAIWritingAssistantTabPage::~OptAIWritingAssistantTabPage() {}
+
+void OptAIWritingAssistantTabPage::Reset(const SfxItemSet*)
+{
+    // Load Enabled state
+    bool bEnabled = officecfg::Office::Linguistic::AIWritingAssistant::Enabled::get();
+    m_xEnabled->set_active(bEnabled);
+
+    // Load API URL
+    std::optional<OUString> oApiUrl
+        = officecfg::Office::Linguistic::AIWritingAssistant::ApiURL::get();
+    if (oApiUrl && !oApiUrl->isEmpty())
+        m_xAPIUrl->set_text(*oApiUrl);
+
+    // Load Auth Key
+    std::optional<OUString> oAuthKey
+        = officecfg::Office::Linguistic::AIWritingAssistant::AuthKey::get();
+    if (oAuthKey && !oAuthKey->isEmpty())
+        m_xAuthKey->set_text(*oAuthKey);
+
+    // Load Model Name
+    std::optional<OUString> oModelName
+        = officecfg::Office::Linguistic::AIWritingAssistant::ModelName::get();
+    if (oModelName && !oModelName->isEmpty())
+        m_xModelName->set_text(*oModelName);
+}
+
+OUString OptAIWritingAssistantTabPage::GetAllStrings()
+{
+    OUString sAllStrings;
+    OUString labels[] = { u"label1"_ustr, u"label2"_ustr, u"label3"_ustr,
+                          u"label4"_ustr, u"label5"_ustr, u"helplabel"_ustr };
+
+    for (const auto& label : labels)
+    {
+        if (const auto pString = m_xBuilder->weld_label(label))
+            sAllStrings += pString->get_label() + " ";
+    }
+
+    return sAllStrings.replaceAll("_", "");
+}
+
+bool OptAIWritingAssistantTabPage::FillItemSet(SfxItemSet*)
+{
+    std::shared_ptr<comphelper::ConfigurationChanges> batch(
+        comphelper::ConfigurationChanges::create());
+
+    officecfg::Office::Linguistic::AIWritingAssistant::Enabled::set(m_xEnabled->get_active(), batch);
+    officecfg::Office::Linguistic::AIWritingAssistant::ApiURL::set(m_xAPIUrl->get_text(), batch);
+    officecfg::Office::Linguistic::AIWritingAssistant::AuthKey::set(m_xAuthKey->get_text(), batch);
+    officecfg::Office::Linguistic::AIWritingAssistant::ModelName::set(m_xModelName->get_text(), batch);
+
+    batch->commit();
+    return false;
+}
+
+std::unique_ptr<SfxTabPage> OptAIWritingAssistantTabPage::Create(weld::Container* pPage,
+                                                                  weld::DialogController* pController,
+                                                                  const SfxItemSet* rAttrSet)
+{
+    return std::make_unique<OptAIWritingAssistantTabPage>(pPage, pController, *rAttrSet);
+}
