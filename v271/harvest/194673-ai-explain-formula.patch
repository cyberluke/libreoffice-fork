+ScAIExplainFormulaDialog::ScAIExplainFormulaDialog(weld::Window* pParent,
+                                                     ScDocShell* pDocSh,
+                                                     const ScAddress& rPos,
+                                                     const OUString& rFormula)
+    : GenericDialogController(pParent, u"modules/scalc/ui/aiexplainformula.ui"_ustr,
+                              u"AIExplainFormulaDialog"_ustr)
+    , m_pDocSh(pDocSh)
+    , m_aPos(rPos)
+    , m_sFormula(rFormula)
+    , m_bExplaining(false)
+    , m_xCellRef(m_xBuilder->weld_entry(u"cellref"_ustr))
+    , m_xFormula(m_xBuilder->weld_entry(u"formula"_ustr))
+    , m_xExplanation(m_xBuilder->weld_text_view(u"explanation"_ustr))
+    , m_xCloseBtn(m_xBuilder->weld_button(u"close"_ustr))
+{
+    // Set dialog size (UI file default-width not always respected)
+    m_xDialog->set_size_request(550, 450);
+
+    // Show cell reference
+    OUString sCellRef = rPos.Format(ScRefFlags::ADDR_ABS);
+    m_xCellRef->set_text(sCellRef);
+    m_xFormula->set_text(m_sFormula);
+
+    m_xCloseBtn->connect_clicked(LINK(this, ScAIExplainFormulaDialog, CloseHdl));
+
+    // Auto-explain on dialog open
+    DoExplain();
+}
+
+void ScAIExplainFormulaDialog::DoExplain()
+{
+    if (m_bExplaining)
+        return;
+
+    m_bExplaining = true;
+
+    // Show "Explaining..." message
+    m_xExplanation->set_text(ScResId(STR_AI_EXPLAINING));
+    Application::Yield();
+
+    // Check if AI is configured
+    if (!ScAIHelper::IsAIConfigured())
+    {
+        m_xExplanation->set_text(ScResId(STR_AI_NOT_CONFIGURED));
+        m_bExplaining = false;
+        return;
+    }
+
+    // Get AI config and make the API call
+    ScAIHelper::AIConfig aConfig = ScAIHelper::GetAIConfig();
+    OUString sSystemPrompt = ScAIHelper::BuildExplainFormulaSystemPrompt();
+    OUString sUserPrompt = u"Explain this spreadsheet formula: "_ustr + m_sFormula;
+
+    SAL_INFO("sc.ai", "Explaining formula: " << m_sFormula);
+
+    m_sExplanation = ScAIHelper::CallChatCompletion(aConfig, sSystemPrompt, sUserPrompt);
+
+    if (m_sExplanation.isEmpty())
+    {
+        m_xExplanation->set_text(ScResId(STR_AI_ERROR));
+    }
+    else
+    {
+        m_xExplanation->set_text(m_sExplanation);
+    }
+
+    m_bExplaining = false;
+
+    // Force UI update
+    Application::Yield();
+}
+
+IMPL_LINK_NOARG(ScAIExplainFormulaDialog, CloseHdl, weld::Button&, void)
+{
+    m_xDialog->response(RET_CLOSE);
+}
