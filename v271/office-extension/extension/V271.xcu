<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE oor:component-data SYSTEM "../../component-update.dtd">
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    oor:name="V271" oor:package="org.openoffice.Office">
  <node oor:name="General">
    <prop oor:name="BaseUrl"><value/></prop>
    <prop oor:name="IssuerUrl"><value/></prop>
    <prop oor:name="ClientId"><value>libreoffice-v271</value></prop>
    <prop oor:name="Scopes"><value>openid profile offline_access</value></prop>
    <prop oor:name="RedirectPort"><value>0</value></prop>
    <prop oor:name="SyncOnSave"><value>true</value></prop>
    <prop oor:name="EmbedOnSave"><value>true</value></prop>
    <prop oor:name="SyncRecentsOnStart"><value>true</value></prop>
    <prop oor:name="MaxChunkSize"><value>2000</value></prop>
    <prop oor:name="FingerprintMode"><value>file</value></prop>
    <prop oor:name="MaxFingerprintBytes"><value>104857600</value></prop>
    <prop oor:name="AllowInsecureTokenStorage"><value>false</value></prop>
  </node>
  <node oor:name="State">
    <prop oor:name="CurrentWorkspaceId"><value/></prop>
    <prop oor:name="LastSyncAt"><value/></prop>
    <prop oor:name="AccountDisplayName"><value/></prop>
  </node>
</oor:component-data>