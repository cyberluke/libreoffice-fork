module com {  module sun {  module star {  module text {

/** Bridge service for the canonical Writer 2027 semantic document layer.

    Instantiate with the component context and query
    ::com::sun::star::text::XWriter2027Semantic. Resolves the owning Writer
    frame/document from the extension-provided frame; all type-system, kit,
    editorial-block, story-view and preflight operations run through the
    canonical writer 2027 implementation.

    @since LibreOffice 8.4
 */
published service Writer2027Semantic : XWriter2027Semantic;


}; }; }; };

