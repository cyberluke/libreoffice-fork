<?xml version="1.0" encoding="UTF-8"?>
<!-- Ported from the abandoned gerrit 194671 airewritedialog.ui (2025-11-27,
     Sanjay Karinje) into officelabs: tracked-changes apply was dropped (no
     sw shell access from officelabs), a status label was added, and the
     style combo carries machine ids for the agent protocol. -->
<interface domain="officelabs">
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkDialog" id="RewriteDialog">
    <property name="can-focus">False</property>
    <property name="border-width">6</property>
    <property name="title" translatable="yes" context="RewriteDialog">Rewrite with AI</property>
    <property name="resizable">True</property>
    <property name="modal">True</property>
    <property name="type-hint">dialog</property>
    <child internal-child="vbox">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child internal-child="action_area">
          <object class="GtkButtonBox" id="action-area1">
            <property name="can-focus">False</property>
            <property name="layout-style">end</property>
            <child>
              <object class="GtkButton" id="generate">
                <property name="label" translatable="yes" context="RewriteDialog">_Generate</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <property name="use-underline">True</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="replace">
                <property name="label" translatable="yes" context="RewriteDialog">_Replace Directly</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <property name="use-underline">True</property>
                <property name="sensitive">False</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="cancel">
                <property name="label" translatable="yes" context="stock">_Cancel</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <property name="use-underline">True</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="content-box">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel" id="stylelabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">start</property>
                <property name="label" translatable="yes" context="RewriteDialog">Rewrite _style:</property>
                <property name="use-underline">True</property>
                <property name="mnemonic-widget">stylebox</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="stylebox">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <items>
                  <item id="clarity" translatable="yes" context="RewriteDialog">Improve clarity</item>
                  <item id="formal" translatable="yes" context="RewriteDialog">More formal</item>
                  <item id="concise" translatable="yes" context="RewriteDialog">More concise</item>
                  <item id="simpler" translatable="yes" context="RewriteDialog">Simpler language</item>
                  <item id="grammar" translatable="yes" context="RewriteDialog">Fix grammar</item>
                  <item id="improve" translatable="yes" context="RewriteDialog">Improve</item>
                </items>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="originallabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">start</property>
                <property name="margin-top">6</property>
                <property name="label" translatable="yes" context="RewriteDialog">_Original text:</property>
                <property name="use-underline">True</property>
                <property name="mnemonic-widget">originaltext</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="originalscroll">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="vexpand">True</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTextView" id="originaltext">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="editable">False</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="cursor-visible">False</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">3</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="suggestionlabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">start</property>
                <property name="margin-top">6</property>
                <property name="label" translatable="yes" context="RewriteDialog">AI _suggestion:</property>
                <property name="use-underline">True</property>
                <property name="mnemonic-widget">suggestiontext</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">4</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="suggestionscroll">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="vexpand">True</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTextView" id="suggestiontext">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="editable">True</property>
                    <property name="wrap-mode">word-char</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">5</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="statuslabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">start</property>
                <property name="margin-top">6</property>
                <property name="label" translatable="yes" context="RewriteDialog"></property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">6</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="101">generate</action-widget>
      <action-widget response="102">replace</action-widget>
      <action-widget response="-6">cancel</action-widget>
    </action-widgets>
  </object>
</interface>