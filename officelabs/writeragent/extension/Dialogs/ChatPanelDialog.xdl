<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
  dlg:id="ChatPanelDialog" dlg:left="0" dlg:top="0" dlg:width="180" dlg:height="330"
  dlg:closeable="false" dlg:moveable="false" dlg:resizeable="false" dlg:withtitlebar="false"
  dlg:title="">
 <dlg:bulletinboard>
  <!-- Top toolbar: settings / tools / hamburger row (never scrolls out of reach). -->
  <dlg:button dlg:id="btn_settings" dlg:left="4" dlg:top="2" dlg:width="16" dlg:height="12" dlg:value="⚙" dlg:tabstop="true"/>
  <dlg:button dlg:id="btn_python" dlg:left="22" dlg:top="2" dlg:width="16" dlg:height="12" dlg:value="" dlg:tabstop="true"/>
  <dlg:button dlg:id="btn_latex" dlg:left="40" dlg:top="2" dlg:width="16" dlg:height="12" dlg:value="√x" dlg:tabstop="true"/>
  <dlg:button dlg:id="btn_search" dlg:left="58" dlg:top="2" dlg:width="16" dlg:height="12" dlg:value="🔍" dlg:tabstop="true"/>
  <dlg:button dlg:id="btn_hamburger" dlg:left="76" dlg:top="2" dlg:width="16" dlg:height="12" dlg:value="☰" dlg:tabstop="true"/>
  <dlg:text dlg:id="backend_indicator" dlg:left="120" dlg:top="4" dlg:width="56" dlg:height="10" dlg:value="" dlg:align="right"/>

  <!-- Response / transcript (replaced at runtime by the rich-text control). -->
  <dlg:text dlg:id="response_label" dlg:left="4" dlg:top="16" dlg:width="142" dlg:height="10" dlg:value="Response" dlg:align="left"/>
  <dlg:textfield dlg:id="response" dlg:left="4" dlg:top="27" dlg:width="142" dlg:height="112" dlg:tabstop="true"
    dlg:value="" dlg:readonly="true" dlg:multiline="true" dlg:vscroll="true" dlg:hscroll="false"/>

  <dlg:textfield dlg:id="status" dlg:left="4" dlg:top="141" dlg:width="142" dlg:height="10" dlg:value=""
    dlg:readonly="true" dlg:border="none" dlg:tabstop="false"/>

  <!-- Ask / instruct block. -->
  <dlg:text dlg:id="query_label" dlg:left="4" dlg:top="153" dlg:width="142" dlg:height="10" dlg:value="Ask / instruct:" dlg:align="left"/>
  <dlg:textfield dlg:id="query" dlg:left="4" dlg:top="165" dlg:width="142" dlg:height="30" dlg:tabstop="true"
    dlg:value="" dlg:multiline="true" dlg:vscroll="true" dlg:hscroll="false"/>
  <dlg:button dlg:id="send" dlg:left="4" dlg:top="197" dlg:width="50" dlg:height="15" dlg:value="Send" dlg:tabstop="true"/>
  <dlg:button dlg:id="stop" dlg:left="56" dlg:top="197" dlg:width="50" dlg:height="15" dlg:value="Stop" dlg:tabstop="true"/>
  <dlg:button dlg:id="clear" dlg:left="108" dlg:top="197" dlg:width="44" dlg:height="15" dlg:value="Clear" dlg:tabstop="true"/>
  <dlg:checkbox dlg:id="chk_voice" dlg:left="154" dlg:top="153" dlg:width="22" dlg:height="14" dlg:value="🔊" dlg:tabstop="true" dlg:checked="false"/>

  <!-- Completion menu overlay (not parked in the bottom band). -->
  <dlg:menulist dlg:id="slash_popup" dlg:left="4" dlg:top="95" dlg:width="142" dlg:height="60" dlg:tabstop="false"/>

  <!-- Mode + model sections (reachable by scrolling when the deck is short). -->
  <dlg:combobox dlg:id="chat_mode_selector" dlg:left="4" dlg:top="215" dlg:width="142" dlg:height="14" dlg:tabstop="true"
    dlg:spin="true" dlg:dropdown="true" dlg:value="Chat" dlg:border="1"/>

  <dlg:text dlg:id="model_label" dlg:left="4" dlg:top="232" dlg:width="142" dlg:height="10" dlg:value="AI Model:" dlg:align="left"/>
  <dlg:combobox dlg:id="model_selector" dlg:left="4" dlg:top="243" dlg:width="142" dlg:height="14" dlg:tabstop="true"
    dlg:spin="true" dlg:dropdown="true" dlg:value="" dlg:border="1"/>

  <!-- Extra instructions / prompt canned list (Chat mode). -->
  <dlg:combobox dlg:id="prompt_selector" dlg:left="4" dlg:top="260" dlg:width="142" dlg:height="14" dlg:tabstop="true"
    dlg:spin="true" dlg:dropdown="true" dlg:value="" dlg:border="1"/>

  <!-- Image generation fields (shown only in Image mode). -->
  <dlg:combobox dlg:id="image_model_selector" dlg:left="4" dlg:top="277" dlg:width="142" dlg:height="14" dlg:tabstop="true"
    dlg:spin="true" dlg:dropdown="true" dlg:value="" dlg:border="1"/>
  <dlg:text dlg:id="base_size_label" dlg:left="4" dlg:top="294" dlg:width="20" dlg:height="10" dlg:value="Base:" dlg:align="left"/>
  <dlg:combobox dlg:id="base_size_input" dlg:left="25" dlg:top="292" dlg:width="40" dlg:height="14" dlg:tabstop="true"
    dlg:spin="true" dlg:dropdown="true" dlg:value="" dlg:border="1"/>
  <dlg:combobox dlg:id="aspect_ratio_selector" dlg:left="70" dlg:top="292" dlg:width="102" dlg:height="14" dlg:tabstop="true"
    dlg:spin="true" dlg:dropdown="true" dlg:value="" dlg:border="1"/>
 </dlg:bulletinboard>
</dlg:window>